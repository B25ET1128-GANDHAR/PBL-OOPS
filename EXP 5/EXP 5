#include <iostream>
using namespace std;

// Function for integer
void display(int n)
{
    cout << "Integer: " << n << endl;
}

// Function for float
void display(float n)
{
    cout << "Float: " << n << endl;
}

// Function for character
void display(char ch)
{
    cout << "Character: " << ch << endl;
}

int main()
{
    display(10);
    display(10.5f);
    display('A');

    return 0;
}


